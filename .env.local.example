# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://jehowbdfqhteznmbyecu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor (bypass RLS). Requerido para enviar notificaciones push.
SUPABASE_SECRET_KEY=

# === Sitio ===
NEXT_PUBLIC_SITE_URL=https://watchily-ho.vercel.app

# === APIs de streaming (opcionales) ===
WATCHMODE_API_KEY=
# Preferido: key directa (developers.movieofthenight.com) — ~1000 req/mes, MX incluido
MOVIEOFTHENIGHT_API_KEY=
# Fallback RapidAPI (~500 req/mes)
STREAMING_AVAILABILITY_API_KEY=
# 1/true (default) = SA para países fuera del plan Watchmode (MX…). 0 = rollback a Watchmode-only
AVAILABILITY_SA_FOR_UNSUPPORTED_REGIONS=1

# === Web Push / PWA ===
# Genera un par con: npx web-push generate-vapid-keys
# La clave pública se expone al cliente; la privada es solo del servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para el servicio de push (mailto: o https:)
VAPID_SUBJECT=mailto:notificaciones@watchily.app
